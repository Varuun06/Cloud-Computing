{
  "info": {
    "name": "Student & Course Microservices",
    "description": "Cloud and Distributed Computing project - two independent REST microservices.\n\nStudent Service: http://localhost:8001  |  Course Service: http://localhost:8002\n\nEvery response carries an X-Service-Name header proving which service answered.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Student Service (port 8001)",
      "description": "CRUD operations on the Student microservice. Works even if the Course Service is stopped.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{student_url}}/health",
              "host": [
                "{{student_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Answered by student-service\", () => pm.expect(pm.response.headers.get(\"X-Service-Name\")).to.eql(\"student-service\"));",
                  "pm.test(\"Service is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{student_url}}/api/students",
              "host": [
                "{{student_url}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Answered by student-service\", () => pm.expect(pm.response.headers.get(\"X-Service-Name\")).to.eql(\"student-service\"));",
                  "pm.test(\"Has data array\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter students (IT, 4th year)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{student_url}}/api/students?department=IT&year=4",
              "host": [
                "{{student_url}}"
              ],
              "path": [
                "api",
                "students"
              ],
              "query": [
                {
                  "key": "department",
                  "value": "IT"
                },
                {
                  "key": "year",
                  "value": "4"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Answered by student-service\", () => pm.expect(pm.response.headers.get(\"X-Service-Name\")).to.eql(\"student-service\"));",
                  "pm.test(\"All results are IT, year 4\", () => pm.response.json().data.forEach(s => {",
                  "  pm.expect(s.department).to.eql(\"IT\"); pm.expect(s.year).to.eql(4); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{student_url}}/api/students",
              "host": [
                "{{student_url}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "description": "Creates a student and stores its id in {{new_student_id}}. Run 'Delete student' before re-running, otherwise you get 409 Conflict for the duplicate register number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"register_number\": \"312222205099\",\n  \"name\": \"Varuun K\",\n  \"email\": \"varuun2210@ssn.edu.in\",\n  \"department\": \"IT\",\n  \"year\": 4,\n  \"cgpa\": 8.7,\n  \"phone\": \"9876543210\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Answered by student-service\", () => pm.expect(pm.response.headers.get(\"X-Service-Name\")).to.eql(\"student-service\"));",
                  "const s = pm.response.json();",
                  "pm.collectionVariables.set(\"new_student_id\", s.id);",
                  "pm.test(\"Has generated id\", () => pm.expect(s.id).to.match(/^S\\d+$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get student by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{student_url}}/api/students/{{new_student_id}}",
              "host": [
                "{{student_url}}"
