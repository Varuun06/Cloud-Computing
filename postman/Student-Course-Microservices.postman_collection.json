    {
      "name": "3. Enrollment (Course Service -> Student Service)",
      "description": "Course Service calls the Student Service over REST to verify the student exists. Requires both services running. Stop the Student Service and run 'Enroll student' again to see 503.",
      "item": [
        {
          "name": "Enroll student in course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{course_url}}/api/courses/{{new_course_id}}/enrollments",
              "host": [
                "{{course_url}}"
              ],
              "path": [
                "api",
                "courses",
                "{{new_course_id}}",
                "enrollments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"{{new_student_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Answered by course-service\", () => pm.expect(pm.response.headers.get(\"X-Service-Name\")).to.eql(\"course-service\"));",
                  "pm.test(\"Student name fetched from Student Service\", () => pm.expect(pm.response.json().student_name).to.be.a(\"string\"));"
                ]
